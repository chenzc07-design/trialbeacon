# TrialBeacon — environment variables (copy to `.env.local` and fill in).
# Anything marked SECRET must stay server-only; never prefix with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Required in production. Signs session + preference cookies. Use a long random
# string (e.g. `openssl rand -hex 32`). Without it, sessions are forgeable.
AUTH_SECRET=

# Optional: Upstash Redis REST URL + token. When set, saved lists / alert
# preferences / stats counters follow the person across devices + instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# OAuth providers (Microsoft + Apple sign-in)
# ---------------------------------------------------------------------------
# Microsoft — Entra ID "common" tenant (any personal or work/school account).
# Register an app, then add the redirect URI: <site>/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Apple — Sign in with Apple (Services ID + key, response_mode=form_post).
# Redirect URI: <site>/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Discussion List Pro (paid tier)
# ---------------------------------------------------------------------------
# PayPal — server-side secrets (NEVER expose to the browser).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' or 'live'. Defaults to sandbox when unset.
PAYPAL_MODE=sandbox
# Billing Plan id for the monthly $6.9 subscription (created in the PayPal
# developer dashboard). Server-side use.
PAYPAL_PLAN_ID=
# PayPal webhook id, for verifying BILLING.SUBSCRIPTION.* events.
PAYPAL_WEBHOOK_ID=

# PayPal — public client id, injected into the browser for the JS SDK.
# This is the SAME value as PAYPAL_CLIENT_ID but is safe to expose publicly.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Public billing plan id for the subscription button (safe to expose).
NEXT_PUBLIC_PAYPAL_PLAN_ID=

# Reserved payment methods (not yet wired — UI shows them greyed "coming soon").
# WECHAT_ENABLED / ALIPAY_ENABLED live in code as `false` for now.

# ---------------------------------------------------------------------------
# Anonymous usage stats
# ---------------------------------------------------------------------------
# Simple token that protects /admin/stats. Pass as ?token=... in the URL.
STATS_TOKEN=
